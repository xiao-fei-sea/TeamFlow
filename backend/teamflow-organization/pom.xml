<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.teamflow</groupId>
        <artifactId>teamflow</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>teamflow-organization</artifactId>
    <name>teamflow-organization</name>
    <description>组织、组织成员、角色、租户校验组件 TenantGuard（M2 填充实现）</description>

    <dependencies>
        <dependency>
            <groupId>com.teamflow</groupId>
            <artifactId>teamflow-common</artifactId>
        </dependency>

        <!-- Redis（TenantGuard 角色缓存 tf:org:member:{orgId}:{userId}，变更即失效） -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-redis</artifactId>
        </dependency>

        <!-- 单元测试（TenantGuard 拒绝路径，纯 Mockito 不起容器） -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>
    </dependencies>
</project>

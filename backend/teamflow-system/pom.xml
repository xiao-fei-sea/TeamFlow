<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.teamflow</groupId>
        <artifactId>teamflow</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>teamflow-system</artifactId>
    <name>teamflow-system</name>
    <description>用户、认证、JWT、登录态（M1 填充实现）</description>

    <dependencies>
        <dependency>
            <groupId>com.teamflow</groupId>
            <artifactId>teamflow-common</artifactId>
        </dependency>

        <!-- 用户搜索需校验 orgId 的 OWNER/ADMIN：复用 organization 的 TenantGuard（依赖方向合法：业务模块 → organization） -->
        <dependency>
            <groupId>com.teamflow</groupId>
            <artifactId>teamflow-organization</artifactId>
        </dependency>

        <!-- Spring Security（认证过滤链/SecurityFilterChain/BCrypt） -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>

        <!-- Redis（登出 JWT 黑名单 tf:auth:blacklist:{jti}） -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-redis</artifactId>
        </dependency>

        <!-- JJWT（HS256 签发/解析；impl 与 jackson 仅运行期需要） -->
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-api</artifactId>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-impl</artifactId>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-jackson</artifactId>
            <scope>runtime</scope>
        </dependency>

        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>
    </dependencies>
</project>
